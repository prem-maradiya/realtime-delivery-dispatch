DATABASE_URL=postgresql+asyncpg://dispatch:dispatch@localhost:5432/dispatch
REDIS_URL=redis://localhost:6379/0
# Search rings in km, tried in order until a driver is found
SEARCH_RADII_KM=[2, 5, 10, 25]
DRIVER_HEARTBEAT_TTL_S=30
SWEEPER_INTERVAL_S=5
ENABLE_SWEEPER=true

# Auth (change both for any shared or deployed environment)
JWT_SECRET=replace-with-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
